# ----------------------------------------------------------------------
# Online Law - Internal Cache & Temp Directory Security Enforcement
# Completely blocks web access to cache, limit files, and temporary data
# ----------------------------------------------------------------------

Options -Indexes -ExecCGI

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
</IfModule>
